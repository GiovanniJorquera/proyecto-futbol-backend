ADMIN_USER=admin
ADMIN_PASSWORD=tu_password_aqui
# Opcional (recomendado): hash bcrypt de la contraseña admin. Si se define, tiene prioridad sobre ADMIN_PASSWORD.
# Generar con: node -e "require('bcrypt').hash('tu_password',10).then(console.log)"
ADMIN_PASSWORD_HASH=
JWT_SECRET=una_clave_secreta_larga_y_aleatoria
MONGODB_URI=tu_uri_de_mongodb_aqui
# Dominio(s) permitidos para CORS, separados por coma. Sin esto, acepta cualquier origen.
CORS_ORIGIN=https://tu-frontend.vercel.app
